# Copie este archivo como .env y ajuste los valores.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Opción A — sin instalar nada: PostgreSQL embebido guardado en ./.pglite
DATABASE_URL=pglite:./.pglite

# Opción B — PostgreSQL real (docker compose up -d en la raíz del proyecto)
# DATABASE_URL=postgres://egt:egt@localhost:5432/egt
# MIGRAR_AL_INICIAR=true

# Cuentas: la primera persona que se registra queda como administrador.
# false → quien se registra entra de una vez (configuración actual).
# true  → la cuenta queda pendiente hasta que un administrador la autorice.
REGISTRO_REQUIERE_APROBACION=false
